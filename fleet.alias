!servalias fleet <drac2>
args = &ARGS&
cmd = args[0] if args else "list"
s_name = "fleet_roster"
roster = load_json(get_svar(s_name, "[]"))

# --- COMMAND: !fleet join ---
if cmd == "join":
    ch = character()
    if ch.name not in [p['n'] for p in roster]:
        roster.append({"n": ch.name, "id": str(ctx.author.id)})
        set_svar(s_name, dump_json(roster))
        return f'embed -title "Fleet Entry Confirmed" -desc "{ch.name} has joined the roster."'
    return f'echo {ch.name} is already in the fleet.'

# --- COMMAND: !fleet clear ---
if cmd == "clear":
    set_svar(s_name, "[]")
    return 'echo Fleet roster cleared.'

# --- COMMAND: !fleet (List Roster) ---
desc = ""
for p in roster:
    # This is the "magic" part: it tries to find the character in the current channel
    # Note: For 9 players, we just display names and basic status
    desc += f"**{p['n']}** | Status: Standby\n"

return f'embed -title "Shadows of Eberron: Fleet Status" -desc "{desc if desc else "No pilots checked in."}" -color #00ff00'
</drac2>